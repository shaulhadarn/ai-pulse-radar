# Everything is optional. Every source works without keys, using Jina Reader where needed.

# Jina Reader (https://jina.ai/reader) fetches pages from Jina's servers, so sources that
# block cloud hosts (Reddit) or need paid keys (X) still work.
#   fallback (default): try each source directly, retry through Jina if blocked
#   always:             send every request through Jina
#   off:                never use Jina
# JINA_MODE=fallback
# Optional free key from https://jina.ai for a higher rate limit than ~20 requests/minute.
JINA_API_KEY=

# X (Twitter) API v2 bearer token. Without it, X posts come from public profiles via Jina.
# Recent search needs at least the Basic tier: https://developer.x.com/en/portal/products
X_BEARER_TOKEN=
# Optional custom X search query (defaults to an AI-techniques query in src/lib/radar/sources/x.ts).
# X_QUERY=(from:karpathy OR from:simonw OR from:swyx) -is:retweet
# Profiles to read through Jina when there is no X API token (comma-separated).
# X_ACCOUNTS=karpathy,simonw,swyx,AnthropicAI,OpenAI

# Raises the GitHub search rate limit. A fine-grained token with no extra scopes is enough.
GITHUB_TOKEN=

# Reddit blocks cloud hosts and Jina, so without these the radar reads the Arctic
# Shift archive (no vote counts). A "script" app at https://www.reddit.com/prefs/apps
# gives you these and switches to the OAuth API.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Comma-separated subreddits to scan.
# REDDIT_SUBREDDITS=LocalLLaMA,MachineLearning,ClaudeAI

# Optional: a Claude-written briefing on the Insights page (refreshed at most hourly).
# Without it the page shows the rule-based analysis only.
ANTHROPIC_API_KEY=
