# Everything is optional. Hacker News, Reddit and GitHub work without keys.

# X (Twitter) API v2 bearer token. Without it the X source is switched off.
# Recent search needs at least the Basic tier: https://developer.x.com/en/portal/products
X_BEARER_TOKEN=
# Optional custom X search query (defaults to an AI-techniques query in src/lib/radar/sources/x.ts).
# X_QUERY=(from:karpathy OR from:simonw OR from:swyx) -is:retweet

# Raises the GitHub search rate limit. A fine-grained token with no extra scopes is enough.
GITHUB_TOKEN=

# Reddit blocks some anonymous requests from cloud hosts. A free "script" app at
# https://www.reddit.com/prefs/apps gives you these and switches to the OAuth API.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Comma-separated subreddits to scan.
# REDDIT_SUBREDDITS=LocalLLaMA,MachineLearning,ClaudeAI
